{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/global.css",
    "functions": ["cva", "cn"],
    "attributes": ["contentContainerClassName"]
  },
  "ignorePatterns": [
    "node_modules",
    ".expo",
    ".env",
    ".env.*",
    "dist",
    "build",
    "coverage",
    ".agents",
    ".claude",
    "bun.lock",
    "ios/**",
    "android/**",
    "src/uniwind-types.d.ts",
    "expo-env.d.ts"
  ]
}
