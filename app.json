{
  "expo": {
    "name": "Lapsha",
    "slug": "lapsha",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lapsha",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/lapsha-ios.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.rogeonee.lapsha",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/android-icon/legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon/foreground.png",
        "monochromeImage": "./assets/android-icon/monochrome.png",
        "backgroundColor": "#F9F7F4"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.rogeonee.lapsha"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon/foreground.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#F9F7F4"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lapsha uses your photo library so you can pick a photo for a person.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-android-backup",
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-dev-client",
        {
          "addGeneratedScheme": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22e93af4-b730-40d9-8d51-cb0b60f2603e"
      }
    },
    "owner": "rogeonee"
  }
}
