{
  "name": "lapsha",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typegen && bun run typecheck",
    "test": "TZ=UTC bun test",
    "test:timezones": "sh scripts/test-timezones.sh",
    "eas-build-post-install": "bun run check",
    "android:gifts-lab": "APP_VARIANT=gifts-lab expo prebuild --platform android --no-install && APP_VARIANT=gifts-lab expo run:android --variant release"
  },
