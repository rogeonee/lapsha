+    activity.lifecycleScope.launch {
+      loadAppReady.await()
+      val host = reactHost
+      if (host != null) {
+        // A published ReactContext can still be initializing its native modules.
+        // Leave the lifecycle mutex/UI thread free while the host finishes startup.
+        val initialized = runInterruptible(Dispatchers.IO) {
+          val startup = host.start()
+          startup.waitForCompletion()
+          !startup.isCancelled() && !startup.isFaulted()
+        }
+        if (!initialized) return@launch
+      }
+      mutex.withLock {
+        delegate.onActivityResult(requestCode, resultCode, data)
+      }
