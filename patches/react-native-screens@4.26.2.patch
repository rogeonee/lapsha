     [self reconcileNavigationStateWithUIKitState];
   }
 }
+
+#if RNS_PROMINENT_TABS_AVAILABLE
+// UIKit's UITab API owns selection on iOS 27. Keep the existing screens state
+// machinery working through its selected-view-controller accessor.
+- (__kindof UIViewController *)selectedViewController
+{
+  if (@available(iOS 27.0, *)) {
+    if (self.tabs.count > 0) {
+      return self.selectedTab.viewController;
+    }
+  }
+  return [super selectedViewController];
+}
+
+#endif
 
