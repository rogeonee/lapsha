{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "bun": "1.3.6"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "bun": "1.3.6"
    },
    "production": {
      "autoIncrement": true,
      "uploadSourceMaps": true,
      "bun": "1.3.6"
    },
    "gifts-lab": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "gifts-lab"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
