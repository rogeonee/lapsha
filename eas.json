{
  "cli": {
    "version": ">= 24.14.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "bun": "1.3.6"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "uploadSourceMaps": true,
      "bun": "1.3.6"
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "uploadSourceMaps": true,
      "bun": "1.3.6",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "beta": {
      "extends": "production",
      "channel": "beta"
    },
    "gifts-lab": {
      "extends": "preview",
      "channel": "gifts-lab",
      "env": {
        "APP_VARIANT": "gifts-lab"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "beta": {
      "extends": "production"
    },
    "production": {
      "ios": {
        "ascAppId": "6823006461",
        "appleTeamId": "NWFF68ZSMD"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
